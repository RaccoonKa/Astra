<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Astra Voice Assistant"
           Manufacturer="Svetozar Kravchuk"
           Version="1.0.0.0"
           UpgradeCode="4F82C9E4-1B18-4E4D-B5F2-81D6C7892301">

    <MajorUpgrade DowngradeErrorMessage="Более новая версия Астры уже установлена на компьютере." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Папка установки: C:\Program Files\Astra -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Astra" />
    </StandardDirectory>

    <!-- Ярлык в меню Пуск -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="7B91F248-8C65-4C41-8930-5A3E92B1C840">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Astra"
                  Description="Astra Voice Assistant"
                  Target="[INSTALLFOLDER]Astra.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\Astra" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Ярлык на Рабочем столе -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="2C8E1903-82BA-4F71-92D0-3D8F9A0B7C61">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="Astra"
                  Description="Голосовой ассистент Астра"
                  Target="[INSTALLFOLDER]Astra.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\Astra" Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Иконка приложения -->
    <Icon Id="AppIcon.ico" SourceFile="assets\icon\ico\icon_round.ico" />

    <!-- Автоматический сбор всех файлов и подпапок из dist\Astra -->
    <ComponentGroup Id="ProductComponents">
      <Files Include="dist\Astra\**" />
    </ComponentGroup>

    <Feature Id="MainApplication" Title="Astra" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>
</Wix>